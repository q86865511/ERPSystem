{
  "name": "erp-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ./openapi/openapi.json -o ./src/api/schema.d.ts",
    "gen:api:check": "openapi-typescript ./openapi/openapi.json -o ./src/api/schema.d.ts && git diff --exit-code ./src/api/schema.d.ts"
  },
  "dependencies": {
    "@mantine/core": "^9.4.0",
    "@mantine/dates": "^9.4.0",
    "@mantine/form": "^9.4.0",
    "@mantine/hooks": "^9.4.0",
    "@mantine/modals": "^9.4.0",
    "@mantine/notifications": "^9.4.0",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.101.1",
    "dayjs": "^1.11.21",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.101.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.0"
  }
}
